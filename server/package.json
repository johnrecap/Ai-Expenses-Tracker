{
  "name": "ai-expenses-vps-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "backfill:firestore": "tsx scripts/firestore-backfill.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "backup:restore-check": "tsx scripts/backup-restore-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:apply:sync-migration": "tsx scripts/apply-sync-migration.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "firebase-admin": "^13.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
