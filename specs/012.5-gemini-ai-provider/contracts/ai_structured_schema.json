{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expense Tracker AI Structured Response",
  "type": "object",
  "additionalProperties": true,
  "required": ["intent", "confidence", "needsConfirmation"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "add_expense",
        "update_expense",
        "delete_expense",
        "search_expenses",
        "summarize_expenses",
        "financial_advice"
      ]
    },
    "amount": {
      "type": ["number", "integer", "null"],
      "minimum": 0
    },
    "category": {
      "type": ["string", "null"]
    },
    "categoryId": {
      "type": ["string", "null"]
    },
    "date": {
      "type": ["string", "null"],
      "description": "ISO-8601 date yyyy-MM-dd when known. Relative dates must be resolved against request now."
    },
    "paymentMethod": {
      "type": ["string", "null"],
      "enum": ["Cash", "Visa", "Wallet", "Bank Transfer", null]
    },
    "currency": {
      "type": ["string", "null"],
      "description": "ISO currency code such as EGP or USD."
    },
    "description": {
      "type": ["string", "null"]
    },
    "query": {
      "type": ["string", "null"]
    },
    "period": {
      "type": ["string", "null"],
      "enum": ["weekly", "monthly", "custom", null]
    },
    "startDate": {
      "type": ["string", "null"]
    },
    "endDate": {
      "type": ["string", "null"]
    },
    "periodText": {
      "type": ["string", "null"]
    },
    "focusCategory": {
      "type": ["string", "null"]
    },
    "tone": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needsConfirmation": {
      "type": "boolean",
      "const": true
    },
    "clarifyingQuestion": {
      "type": ["string", "null"]
    }
  }
}
